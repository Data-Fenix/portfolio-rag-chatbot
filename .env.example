# Required
ANTHROPIC_API_KEY=sk-ant-...

# Model and generation
MODEL=claude-opus-5-5
JUDGE_MODEL=claude-sonnet-5-5
EFFORT=low
MAX_OUTPUT_TOKENS=2048

# Retrieval: bm25 (default, no extra deps) | chroma | hybrid
RETRIEVER_BACKEND=bm25
TOP_K=5

# Server
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://data-fenix.github.io
RATE_LIMIT_PER_MINUTE=20
LOG_LEVEL=INFO
